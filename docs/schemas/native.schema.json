{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "XMPP native metadata namespace version 1",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sender_jid": {
      "type": "string"
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "message_type": {
      "enum": [
        "chat",
        "normal",
        "groupchat"
      ]
    },
    "stanza_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "room_stanza_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Room-assigned stanza ID from a room advertising XEP-0359 at receipt time; absent for unverified namespaces."
    },
    "origin_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Origin-generated ID retained independently of a server-rewritten stanza ID."
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_context"
      ],
      "properties": {
        "bridge_context": {
          "$ref": "#/$defs/BridgeContext"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "sender_jid",
    "nickname",
    "message_type",
    "stanza_id"
  ],
  "$defs": {
    "BridgeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "relations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/BridgeSource"
        },
        "relations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/BridgeRelation"
          }
        }
      }
    },
    "BridgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "canonical_event_id",
        "channel",
        "sender_id",
        "native_ref"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "canonical_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_short_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "sender_verification": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "origin_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "native_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BridgeNativeRef"
            }
          ]
        }
      }
    },
    "BridgeRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "target_event_id",
        "target_native_ref",
        "key"
      ],
      "properties": {
        "relation_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target_event_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "target_native_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BridgeNativeRef"
            }
          ]
        }
      }
    },
    "BridgeNativeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "native_channel_id",
        "native_message_id",
        "native_thread_id"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "native_channel_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "native_message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "native_thread_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    }
  }
}
